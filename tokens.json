{
  "$metadata": {
    "tokenSetOrder": ["global", "semantic", "component"]
  },
  "$themes": [],
  "global": {
    "palette": {
      "gray-900": { "$type": "color", "$value": "#111113" },
      "gray-800": { "$type": "color", "$value": "#1E222A" },
      "gray-50": { "$type": "color", "$value": "#F9F9FB" },
      "gray-200": { "$type": "color", "$value": "#E2E8F0" },
      "copper-600": { "$type": "color", "$value": "#A8582A" },
      "teal-700": { "$type": "color", "$value": "#0F766E" }
    },
    "space": {
      "4": { "$type": "spacing", "$value": "4" },
      "8": { "$type": "spacing", "$value": "8" },
      "12": { "$type": "spacing", "$value": "12" },
      "16": { "$type": "spacing", "$value": "16" },
      "24": { "$type": "spacing", "$value": "24" },
      "32": { "$type": "spacing", "$value": "32" },
      "48": { "$type": "spacing", "$value": "48" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "8" },
      "md": { "$type": "borderRadius", "$value": "16" }
    },
    "font": {
      "family": {
        "base": { "$type": "fontFamilies", "$value": "Inter" }
      },
      "size": {
        "caption": { "$type": "fontSizes", "$value": "13" },
        "body": { "$type": "fontSizes", "$value": "16" },
        "h3": { "$type": "fontSizes", "$value": "20" },
        "h2": { "$type": "fontSizes", "$value": "25" },
        "h1": { "$type": "fontSizes", "$value": "31" },
        "display": { "$type": "fontSizes", "$value": "39" }
      },
      "weight": {
        "regular": { "$type": "fontWeights", "$value": "400" },
        "medium": { "$type": "fontWeights", "$value": "500" },
        "semibold": { "$type": "fontWeights", "$value": "600" },
        "bold": { "$type": "fontWeights", "$value": "700" }
      },
      "lineheight": {
        "tight": { "$type": "lineHeights", "$value": "1.2" },
        "normal": { "$type": "lineHeights", "$value": "1.3" },
        "relaxed": { "$type": "lineHeights", "$value": "1.5" }
      }
    }
  },
  "semantic": {
    "color": {
      "bg-page": { "$type": "color", "$value": "{palette.gray-50}" },
      "text-primary": { "$type": "color", "$value": "{palette.gray-900}" },
      "brand-primary": { "$type": "color", "$value": "{palette.gray-800}" },
      "surface": { "$type": "color", "$value": "{palette.gray-200}" },
      "action": { "$type": "color", "$value": "{palette.copper-600}" },
      "positive": { "$type": "color", "$value": "{palette.teal-700}" }
    }
  },
  "component": {
    "button": {
      "bg-primary": { "$type": "color", "$value": "{color.action}" },
      "text-primary": { "$type": "color", "$value": "{color.bg-page}" },
      "bg-secondary": { "$type": "color", "$value": "{color.brand-primary}" }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{color.bg-page}" },
      "border": { "$type": "color", "$value": "{color.surface}" }
    },
    "badge": {
      "bg": { "$type": "color", "$value": "{color.positive}" },
      "text": { "$type": "color", "$value": "{color.bg-page}" }
    }
  }
}
